# SMTP credentials used to send transactional email. Works locally
# (next dev / next start run on Node), but this will NOT work once deployed
# to Cloudflare Workers — that runtime can't open raw TCP/SMTP sockets, so
# nodemailer fails there regardless of these values being correct. Never
# commit the real values (use .env.local, which is gitignored) — this file
# is just a template.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apply@avenza-consulting.com
SMTP_PASS=your-smtp-password-or-app-key
CAREERS_INBOX_EMAIL=careers@avenza-consulting.com

# Where contact-page submissions are sent. Optional — falls back to
# CAREERS_INBOX_EMAIL when not set.
CONTACT_INBOX_EMAIL=contact@avenza-consulting.com

# Google Sheet published as CSV (File > Share > Publish to web > select the
# jobs sheet/tab > CSV). Leave blank to use the built-in fallback jobs in
# src/data/content.ts instead. Must be NEXT_PUBLIC_ since it's fetched from
# the browser.
NEXT_PUBLIC_JOBS_SHEET_CSV_URL=

# Base "Publish to web" CSV URL (File > Share > Publish to web > Entire
# document > CSV) for the Life @ Avenza photo tabs — typically the same
# published spreadsheet as the jobs sheet above, since each tab (yercaud,
# celebrations, cricket, team-outing) is reached by its own &gid= appended
# at fetch time. Leave blank to hide the sheet-driven photo galleries.
NEXT_PUBLIC_LIFE_PHOTOS_SHEET_CSV_URL=

# The public base URL of this deployment (no trailing slash). Used to build
# absolute links in outgoing emails. Set this per environment.
NEXT_PUBLIC_SITE_URL=https://avenza-web.vercel.app

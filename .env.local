# SMTP credentials used to send transactional email. Works locally
# (next dev / next start run on Node), but note this will NOT work once
# deployed to Cloudflare Workers — that runtime can't open raw TCP/SMTP
# sockets, so nodemailer will fail there regardless of these values being
# correct. This file is never uploaded to Cloudflare and must never be
# committed to git.
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=noreply@avenza-consulting.com
SMTP_PASS=wlrzrwclxmfmzmkp
CAREERS_INBOX_EMAIL=jabiulla.sm@avenza-consulting.com

# Where contact-page submissions are sent. Optional — falls back to
# CAREERS_INBOX_EMAIL above when not set.
# CONTACT_INBOX_EMAIL=

# Publish your jobs Google Sheet to the web as CSV and paste the URL here.
# Leave blank to keep using the built-in jobs list in src/data/content.ts.
NEXT_PUBLIC_JOBS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vRkei-9_ioAfH7u00pjLfiEoCoqFat1NcSZb0g8yl_tS4t7n3Eow2Cbt1f7xCxMAaYTe_OXI7PpRdPg/pub?gid=0&single=true&output=csv

# The public base URL of this deployment (no trailing slash). Used to build
# absolute links in outgoing emails (e.g. the Life @ Avenza link in the
# application confirmation email). Update this per environment — it's
# different for local dev, Vercel, and Cloudflare Workers deployments.
NEXT_PUBLIC_SITE_URL=https://avenza-web.vercel.app

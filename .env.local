# Resend (https://resend.com) API key used to send transactional email.
# Required in every environment, including Cloudflare — set this in the
# Cloudflare Pages/Workers dashboard under Settings > Environment Variables
# for production, since .env.local is never uploaded there.
RESEND_API_KEY=

# Must be an address on a domain verified in Resend.
EMAIL_FROM=noreply@avenza-consulting.com
CAREERS_INBOX_EMAIL=jabiulla.sm@avenza-consulting.com

# Where contact-page submissions are sent. Optional — falls back to
# CAREERS_INBOX_EMAIL above when not set.
# CONTACT_INBOX_EMAIL=

# Publish your jobs Google Sheet to the web as CSV and paste the URL here.
# Leave blank to keep using the built-in jobs list in src/data/content.ts.
NEXT_PUBLIC_JOBS_SHEET_CSV_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vRkei-9_ioAfH7u00pjLfiEoCoqFat1NcSZb0g8yl_tS4t7n3Eow2Cbt1f7xCxMAaYTe_OXI7PpRdPg/pub?gid=0&single=true&output=csv
